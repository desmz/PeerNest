{
  "folders": [
    {
      "name": "api-server",
      "path": "./apps/api-server",
    },
    {
      "name": "web",
      "path": "./apps/web",
    },
    {
      "name": "config",
      "path": "./packages/config",
    },
    {
      "name": "core",
      "path": "./packages/core",
    },
    {
      "name": "db",
      "path": "./packages/db",
    },
    {
      "name": "contract",
      "path": "./packages/contract",
    },
    {
      "name": "transactional",
      "path": "./packages/transactional",
    },
    // {
    //   "name": "ui-lib",
    //   "path": "./packages/ui-lib",
    // },
    // {
    //   "name": "eslint-config-bases",
    //   "path": "./packages/eslint-config-bases",
    // },
    {
      "name": "root",
      "path": ".",
    },
  ],
  "extensions": {
    "recommendations": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
  },
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
    },
    // Disable vscode formatting for js,jsx,ts,tsx files
    // to allow dbaeumer.vscode-eslint to format them
    // "[javascript]": {
    //   "editor.formatOnSave": false,
    // },
    // https://github.com/Microsoft/vscode-eslint#mono-repository-setup
    "eslint.workingDirectories": [
      "./apps/api-server",
      "./apps/web",
      "./packages/config",
      "./packages/core",
      "./packages/db",
      "./packages/contract",
      "./packages/transactional",
      // "./packages/ui-lib",
      // "./packages/eslint-config-bases",
    ],
    "search.exclude": {
      "**/node_modules": true,
      "**/bower_components": true,
      "**/*.code-search": true,
      "**/dist": true,
    },
    "cSpell.words": [
      "peernest",
      "kysely",
      "uuidv7",
      "updateable",
      "insertable",
      "varchar",
      "tsvector",
      "timestamptz",
      "aggs",
      "unaccent",
    ],
    "peacock.remoteColor": "#374d6a",
    "github.copilot.enable": {
      "*": false,
      "plaintext": false,
      "markdown": true,
      "scminput": false,
    },
  },
}
